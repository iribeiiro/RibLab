{
  "entities": {
    "ServiceOrder": {
      "title": "Service Order",
      "description": "Represents a maintenance request for a computer or notebook.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deviceType": { "type": "string", "enum": ["Desktop", "Notebook", "All-in-One", "Other"] },
        "deviceBrand": { "type": "string" },
        "deviceModel": { "type": "string" },
        "serialNumber": { "type": "string" },
        "problemDescription": { "type": "string" },
        "technicalReport": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Waiting for Parts", "Completed", "Canceled"] },
        "priority": { "type": "string", "enum": ["Low", "Normal", "High", "Urgent"] },
        "partsCost": { "type": "number" },
        "serviceCost": { "type": "number" },
        "totalCost": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Dinheiro", "Pix", "Cartão de Crédito", "Cartão de Débito", "Transferência", "Outro"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["customerName", "deviceType", "problemDescription", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Represents a client.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "street": { "type": "string" },
        "number": { "type": "string" },
        "complement": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "reference": { "type": "string" },
        "cep": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "phone", "createdBy", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Represents a product in stock.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "number" },
        "costPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "quantity", "costPrice", "salePrice"]
    },
    "Sale": {
      "title": "Sale History",
      "description": "Record of a sold item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "costPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "profit": { "type": "number" },
        "soldAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productName", "quantity", "costPrice", "salePrice", "profit", "soldAt"]
    }
  },
  "firestore": {
    "/serviceOrders/{orderId}": {
      "schema": "ServiceOrder",
      "description": "Collection of all service orders."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Collection of all customers."
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Stock management."
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Sales history for profit tracking."
    }
  }
}
